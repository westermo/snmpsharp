<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
        <PackageReference Include="TUnit"/>
        <ProjectReference Include="../../src/SnmpSharpNet.csproj"/>
        <ProjectReference Include="../../Mib/SnmpSharpNet.Mib.csproj"/>
        <ProjectReference Include="../../Mib.SourceGenerator/SnmpSharpNet.Mib.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="../mibs/*.mib" Link="$(Filename)$(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="CompilerGeneratedFilesOutputPath"
                          Value="$([System.IO.Path]::GetFullPath('$(CompilerGeneratedFilesOutputPath)', '$(MSBuildProjectDirectory)'))" />
    </ItemGroup>

</Project>
