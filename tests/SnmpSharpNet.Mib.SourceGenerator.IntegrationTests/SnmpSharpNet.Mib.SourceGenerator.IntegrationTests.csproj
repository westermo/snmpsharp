<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
        <ProjectReference Include="../../src/SnmpSharpNet.csproj"/>
        <ProjectReference Include="../../Mib/SnmpSharpNet.Mib.csproj"/>
        <ProjectReference Include="../../Mib.SourceGenerator/SnmpSharpNet.Mib.SourceGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="true"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="../mibs/*.mib" Link="$(Filename)$(Extension)"/>
    </ItemGroup>

</Project>
